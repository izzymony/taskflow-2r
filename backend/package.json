    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
