# Copy to .env.local and fill in real values. Never commit .env or .env.local.

# MySQL connection string used by Drizzle (mysql2).
# Both formats are supported:
#   mysql://user:password@host:3306/database
#   jdbc:mysql://user:password@host:4000/database?ssl-mode=REQUIRED   (TiDB Cloud)
# A "ssl-mode" parameter is translated into the TLS setting automatically and is
# never forwarded to the driver. Use a dedicated database, not a system one.
DATABASE_URL=mysql://root:password@localhost:3306/taskflow

# Secret used to sign access tokens (HS256). Use at least 32 random characters.
JWT_SECRET=replace_with_a_long_random_secret

# Port the Express API listens on.
PORT=8000

# Comma separated list of browser origins allowed to call the API.
# The deployed frontend origin MUST be listed here or the browser blocks the request.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Cookie policy for the auth tokens.
#   lax    - frontend and API share a site (localhost -> localhost)
#   none   - frontend and API are on different domains; requires HTTPS
COOKIE_SAME_SITE=lax

# Optional: connection timeout for the `bun run db:check` script (milliseconds).
DB_CONNECT_TIMEOUT=20000
